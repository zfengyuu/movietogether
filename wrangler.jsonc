{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hoiroom-3d",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-31",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "HoiRoomContainer",
      "scheduling_policy": "durable_object",
      "max_instances": 1,
      "images": {
        "base": { "dockerfile": "./Dockerfile.cloudflare", "build_context": "." }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "HOIROOM_CONTAINER", "class_name": "HoiRoomContainer" }
    ]
  },
  "exports": {
    "HoiRoomContainer": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "PAYMENTS_MODE": "disabled",
    "DEMO_WALLET_ENABLED": "false"
  }
}
