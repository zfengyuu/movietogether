# Cloudflare Container: build React and serve Express + Socket.IO from same process.
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install --no-audit --no-fund
COPY . .
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production SERVE_STATIC=true PORT=3001 UPLOAD_ROOT=/tmp/hoiroom
COPY --from=build /app/package*.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/server ./server
COPY --from=build /app/shared ./shared
COPY --from=build /app/db ./db
COPY --from=build /app/scripts/migrate-db.mjs ./scripts/migrate-db.mjs
USER node
EXPOSE 3001
# There is no Render preDeployCommand on Cloudflare. Run idempotent SQL migrations on start.
CMD ["sh", "-c", "node scripts/migrate-db.mjs && exec node server/index.js"]
