{
  "name": "hoiroom-3d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "check": "node --check server/index.js",
    "smoke": "node scripts/smoke-test.mjs",
    "test:youtube": "node --test tests/*.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "node scripts/migrate-db.mjs",
    "db:setup": "npm install",
    "start:production": "node server/index.js",
    "deploy:cloudflare": "wrangler deploy",
    "dev:cloudflare": "wrangler dev"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "express": "^5.1.0",
    "hls.js": "^1.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "three": "^0.180.0",
    "dotenv": "^16.4.7",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.2.0",
    "vite": "^6.3.0",
    "wrangler": "^4.102.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
