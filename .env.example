# VIMO CINÉ backend
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
SERVE_STATIC=true
# Local-only demo wallet (cannot be used as real bank balance)
DEMO_WALLET_ENABLED=true
# Optional VietQR transfer request. Transfer does NOT automatically credit wallet.
# VIMO_BANK_ID=970422
# VIMO_BANK_ACCOUNT=YOUR_BANK_ACCOUNT
# VIMO_BANK_NAME=YOUR_ACCOUNT_NAME
# Production requires a verified bank/provider webhook, SQL transactions,
# persistent wallet ledger, reconciliation and idempotent crediting.

# PostgreSQL sandbox wallet: run npm run db:setup && npm run db:migrate
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hoiroom
# PAYMENTS_MODE=sandbox
# SEPAY_WEBHOOK_SECRET=replace_with_long_random_secret
# VIETQR_BANK_ACCOUNT=SANDBOX_ACCOUNT

# Database-backed sign up/login requires pg installed and BOTH migrations.
# Run: npm run db:setup && npm run db:migrate
# To retain existing JSON accounts (one-time): node scripts/import-legacy-accounts.mjs
# Without DATABASE_URL, only local development stores accounts in auth-data/accounts.json.
# Production startup now REQUIRES DATABASE_URL (never enable real payments on JSON users).
