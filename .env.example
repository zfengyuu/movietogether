# Backend
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
# Production: if running build on a single Node host, serve dist assets:
SERVE_STATIC=true
# Optional voice chat using LiveKit Cloud or self-hosted LiveKit
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...

# VietQR / SePay – SANDBOX ONLY. No real transfers are enabled.
# PAYMENTS_MODE=sandbox
# SEPAY_WEBHOOK_SECRET=replace_with_long_sandbox_secret
# VIETQR_BANK_ACCOUNT=SANDBOX_ACCOUNT_NUMBER
# VIETQR_BANK_CODE=VCB
# VIETQR_ACCOUNT_NAME=SANDBOX ONLY
# To receive real money, first migrate wallet + ledger to transactional Postgres,
# implement reconciliation/refunds, then complete SePay merchant onboarding.

# Optional PostgreSQL storage for sandbox wallet and transactional ledger.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hoiroom
# Run npm run db:migrate before enabling PAYMENTS_MODE=sandbox.
# DO NOT switch to real money until identity/session and photo storage are fully hardened.
