# Local development defaults, not live payment configuration.
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
SERVE_STATIC=false
DEMO_WALLET_ENABLED=true
PAYMENTS_MODE=disabled

# For PostgreSQL-backed account registration, login and wallet:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hoiroom
# Run: npm install && npm run db:migrate
# For Render, the Blueprint injects DATABASE_URL automatically.

# Persistent upload root (on Render: /app/storage via render.yaml)
# UPLOAD_ROOT=/app/storage

# Optional VietQR image only; DOES NOT mean funds were received:
# VIMO_BANK_ID=YOUR_BANK_BIN
# VIMO_BANK_ACCOUNT=YOUR_BANK_ACCOUNT
# VIMO_BANK_NAME=YOUR_BANK_ACCOUNT_NAME

# Sandbox-only signed SePay webhook integration. NEVER paste secrets into git.
# PAYMENTS_MODE=sandbox
# SEPAY_WEBHOOK_SECRET=REPLACE_WITH_TEST_SECRET
# VIETQR_BANK_ACCOUNT=YOUR_SANDBOX_RECEIVING_ACCOUNT

# Do not enable live payments without provider verification, reconciliation and backups.
